rules_version = '2';

// Personal Expense Tracker - Cloud Firestore security rules.
// Each signed-in user can read and write ONLY the documents under users/{their own uid}. Nobody else can see them,
// and signed-out visitors get nothing. Everything not listed here is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}  (meta document)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // users/{uid}/transactions/{id}, budgets, savingsGoals, goalContributions, recurringRules, ...
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
